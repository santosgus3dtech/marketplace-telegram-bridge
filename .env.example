GMAIL_REPLY_WATCH_NOT_BEFORE=
GMAIL_REPLY_WATCH_POLL_SECONDS=120
GMAIL_REPLY_WATCH_LOOKBACK_DAYS=14
GMAIL_REPLY_WATCH_MAX_MESSAGES=250
GMAIL_REPLY_WATCH_STOP_AFTER_MATCH=true

DELIVERY_WORKER_ENABLED=true
DELIVERY_WORKER_POLL_SECONDS=1
DELIVERY_WORKER_BATCH_SIZE=10
DELIVERY_MAX_ATTEMPTS=5
DELIVERY_BACKOFF_SECONDS=1
